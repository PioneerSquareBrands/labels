{
  "name": "upc-label-generator",
  "version": "1.0.0",
  "description": "Just a simple UPC and Shipping Mark label generator",
  "scripts": {
    "build:js": "esbuild src/js/main.js --bundle --format=esm --outfile=dist/js/main.js",
    "build:css": "sass src/scss/styles.scss .cache/styles.css --no-source-map && postcss .cache/styles.css -o dist/css/styles.css --no-map",
    "build:vendors": "cp src/js/vendors.js dist/js/vendors.js",
    "build": "npm run build:js && npm run build:css && npm run build:vendors",
    "watch:js": "npm run build:js -- --watch",
    "watch:css": "concurrently -r \"sass --watch src/scss/styles.scss .cache/styles.css --no-source-map\" \"postcss .cache/styles.css -o dist/css/styles.css --no-map --watch\"",
    "dev": "npm run build && concurrently -n js,css,serve -c blue,magenta,green \"npm:watch:js\" \"npm:watch:css\" \"npm:serve\"",
    "serve": "browser-sync start --server --startPath index.html --files \"index.html\" \"dist/css/*.css\" \"dist/js/*.js\" --no-notify --no-open"
  },
  "dependencies": {
    "@jaames/iro": "5.5.2",
    "html-to-image": "1.11.11",
    "jsbarcode": "3.11.6",
    "jspdf": "2.5.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "sass": "^1.103.1"
  },
  "browserslist": [
    "last 2 versions"
  ]
}
